    hv = IADD h7 0 8

    t = 0
  LABEL rnd
    rdone = IGE t 64 8
    BRANCH rdone rfin rbody
  LABEL rbody
    kt4 = IMUL t 4 8
    kt = LOAD buf 4 kt4
    kt = AND kt M 8
    wo = IADD kt4 256 8
    wt = LOAD buf 4 wo
