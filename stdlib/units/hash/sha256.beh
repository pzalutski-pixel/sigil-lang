  h2 = 1013904242
  h3 = 2773480762
  h4 = 1359893119
  h5 = 2600822924
  h6 = 528734635
  h7 = 1541459225

  ci = 0
  LABEL chunkloop
    cdone = IGE ci plen 8
    BRANCH cdone chunkfin chunkbody
  LABEL chunkbody
    mbase = IADD ci 512 8

    t = 0
  LABEL wload
    wldone = IGE t 16 8
    BRANCH wldone wlfin wlbody
  LABEL wlbody
    t4 = IMUL t 4 8
    bo = IADD mbase t4 8
    c0 = LOAD buf 1 bo
    c0 = AND c0 255 8
    p0 = SHL c0 24 8
    bo1 = IADD bo 1 8
    c1 = LOAD buf 1 bo1
    c1 = AND c1 255 8
    p1 = SHL c1 16 8
    bo2 = IADD bo 2 8
    c2 = LOAD buf 1 bo2
    c2 = AND c2 255 8
    p2 = SHL c2 8 8
    bo3 = IADD bo 3 8
    c3 = LOAD buf 1 bo3
    c3 = AND c3 255 8
    wv = OR p0 p1 8
    wv = OR wv p2 8
    wv = OR wv c3 8
    woff = IADD t4 256 8
    STORE buf wv 4 woff
    t = IADD t 1 8
    JUMP wload
  LABEL wlfin

    t = 16
  LABEL wext
    wedone = IGE t 64 8
    BRANCH wedone wefin webody
  LABEL webody
    tm15 = ISUB t 15 8
    o15 = IMUL tm15 4 8
