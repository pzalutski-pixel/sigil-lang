BEHAVIOR consumer-main

DESCRIPTION
  HTTP file relay consumer. Listens on TCP port 9823, accepts one connection,
  receives the HTTP POST, extracts the body, prepends a timestamp and
  " PROCESSED BY CONSUMER\n", and writes the result to output.txt.

CONTRACT
  OUTPUT status int 8
  REQUIRES socket@0fec0e0c make-sockaddr@a9866fc0 bind@697435f5 listen@95b7eb35 accept@e88849be receive@2ae7614b now@cee78134 format-time@83ebda2d assemble-output@51ae88c1 write-file-all@b17d9aa8 close-socket@d4ba30e5 println@a273ebb3
  GUARANTEES writes_output

HASH 0f8df414

COMPOSITION
  msg = "Consumer listening on port 9823"
  CALL println msg

  # AF_INET=2, SOCK_STREAM=1
  sock_result = CALL socket 2 1
  sock_fd = sock_result.fd

  # Bind to port 9823 on all interfaces (ip 0)
  addr_result = CALL make-sockaddr 9823 0
  bind_result = CALL bind sock_fd addr_result.addr addr_result.addr_len
  DISCARD bind_result

  listen_result = CALL listen sock_fd 10
  DISCARD listen_result

  accept_result = CALL accept sock_fd
  client_fd = accept_result.client_fd
  DISCARD accept_result.client_addr
  DISCARD accept_result.addr_len

  # Receive the request (up to 65536 bytes)
  recv_result = CALL receive client_fd 65536

  # Timestamp: now (ms since epoch) -> "YYYY-MM-DD HH:MM:SS"
  time_result = CALL now
  ts = CALL format-time time_result.timestamp

  # Assemble <timestamp> PROCESSED BY CONSUMER\n<body>
  out = CALL assemble-output recv_result.buffer recv_result.bytes_received ts.formatted ts.length

  # Write to output.txt
  path = "output.txt"
  wr = CALL write-file-all path out.result out.result_len
  DISCARD wr

  close_result = CALL close-socket client_fd
  DISCARD close_result

  done_msg = "Consumer wrote output.txt"
  CALL println done_msg

  SET status 0
END
