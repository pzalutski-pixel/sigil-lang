BEHAVIOR format-response

DESCRIPTION
  Formats HTTP response with status code, headers, and body.
  Builds complete HTTP/1.1 response.

CONTRACT
  INPUT status_code int 8
  INPUT content_type bytes 64
  INPUT body bytes 8192
  INPUT body_length int 8
  OUTPUT response bytes 16384
  OUTPUT response_length int 8
  GUARANTEES writes_output

HASH b06c6ec0

IMPLEMENTATION
  out_pos = ALLOC 8 int
  STORE out_pos 0 8
  j = ALLOC 8 int
  STORE j 0 8

  code = LOAD status_code 8

  STORE response 72 1 0
  STORE response 84 1 1
  STORE response 84 1 2
  STORE response 80 1 3
  STORE response 47 1 4
  STORE response 49 1 5
  STORE response 46 1 6
  STORE response 49 1 7
  STORE response 32 1 8
  STORE out_pos 9 8

  is_200 = IEQ code 200 8
  BRANCH is_200 write_200 check_404

  LABEL write_200
    STORE response 50 1 9
    STORE response 48 1 10
    STORE response 48 1 11
    STORE response 32 1 12
    STORE response 79 1 13
    STORE response 75 1 14
    STORE out_pos 15 8
    JUMP write_crlf

  LABEL check_404
    is_404 = IEQ code 404 8
    BRANCH is_404 write_404 check_500

  LABEL write_404
    STORE response 52 1 9
    STORE response 48 1 10
    STORE response 52 1 11
    STORE response 32 1 12
    STORE response 78 1 13
    STORE response 111 1 14
    STORE response 116 1 15
    STORE response 32 1 16
    STORE response 70 1 17
    STORE response 111 1 18
    STORE response 117 1 19
    STORE response 110 1 20
    STORE response 100 1 21
    STORE out_pos 22 8
    JUMP write_crlf

  LABEL check_500
    STORE response 53 1 9
    STORE response 48 1 10
    STORE response 48 1 11
    STORE response 32 1 12
    STORE response 69 1 13
    STORE response 114 1 14
    STORE response 114 1 15
    STORE response 111 1 16
    STORE response 114 1 17
    STORE out_pos 18 8

  LABEL write_crlf
    pos = LOAD out_pos 8
    STORE response 13 1 pos
    pos = IADD pos 1 8
    STORE response 10 1 pos
    pos = IADD pos 1 8
    STORE out_pos pos 8

  LABEL write_end_headers
    pos = LOAD out_pos 8
    STORE response 13 1 pos
    pos = IADD pos 1 8
    STORE response 10 1 pos
    pos = IADD pos 1 8
    STORE out_pos pos 8

  LABEL copy_body_start
    body_len = LOAD body_length 8
    STORE j 0 8

  LABEL copy_body
    idx = LOAD j 8
    done_body = IGE idx body_len 8
    BRANCH done_body finish_response copy_body_byte

  LABEL copy_body_byte
    idx = LOAD j 8
    byte = LOAD body 1 idx
    pos = LOAD out_pos 8
    STORE response byte 1 pos
    pos = IADD pos 1 8
    STORE out_pos pos 8
    new_idx = IADD idx 1 8
    STORE j new_idx 8
    JUMP copy_body

  LABEL finish_response
    pos = LOAD out_pos 8
    STORE response 0 1 pos
    STORE response_length pos 8
    FREE out_pos
    FREE j
END
