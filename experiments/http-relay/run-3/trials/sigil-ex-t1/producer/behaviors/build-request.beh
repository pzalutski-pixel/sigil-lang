BEHAVIOR build-request

DESCRIPTION
  Builds a minimal HTTP/1.1 POST request whose body is the given bytes.
  Request line + Host header + blank line, then the body verbatim:
    POST / HTTP/1.1\r\nHost: localhost\r\n\r\n<body>
  body      = body bytes to post
  body_len  = number of valid body bytes
  req       = assembled request bytes
  req_len   = number of bytes written to req

CONTRACT
  INPUT body bytes 65536
  INPUT body_len int 8
  OUTPUT req bytes 65536
  OUTPUT req_len int 8
  GUARANTEES writes_output

HASH cc30d563

IMPLEMENTATION
  i = ALLOC 8 int
  STORE i 0 8
  op = ALLOC 8 int
  STORE op 0 8

  # "POST / HTTP/1.1\r\n"
  pos = LOAD op 8
  STORE req 80 1 pos
  pos = IADD pos 1 8
  STORE req 79 1 pos
  pos = IADD pos 1 8
  STORE req 83 1 pos
  pos = IADD pos 1 8
  STORE req 84 1 pos
  pos = IADD pos 1 8
  STORE req 32 1 pos
  pos = IADD pos 1 8
  STORE req 47 1 pos
  pos = IADD pos 1 8
  STORE req 32 1 pos
  pos = IADD pos 1 8
  STORE req 72 1 pos
  pos = IADD pos 1 8
  STORE req 84 1 pos
  pos = IADD pos 1 8
  STORE req 84 1 pos
  pos = IADD pos 1 8
  STORE req 80 1 pos
  pos = IADD pos 1 8
  STORE req 47 1 pos
  pos = IADD pos 1 8
  STORE req 49 1 pos
  pos = IADD pos 1 8
  STORE req 46 1 pos
  pos = IADD pos 1 8
  STORE req 49 1 pos
  pos = IADD pos 1 8
  STORE req 13 1 pos
  pos = IADD pos 1 8
  STORE req 10 1 pos
  pos = IADD pos 1 8

  # "Host: localhost\r\n"
  STORE req 72 1 pos
  pos = IADD pos 1 8
  STORE req 111 1 pos
  pos = IADD pos 1 8
  STORE req 115 1 pos
  pos = IADD pos 1 8
  STORE req 116 1 pos
  pos = IADD pos 1 8
  STORE req 58 1 pos
  pos = IADD pos 1 8
  STORE req 32 1 pos
  pos = IADD pos 1 8
  STORE req 108 1 pos
  pos = IADD pos 1 8
  STORE req 111 1 pos
  pos = IADD pos 1 8
  STORE req 99 1 pos
  pos = IADD pos 1 8
  STORE req 97 1 pos
  pos = IADD pos 1 8
  STORE req 108 1 pos
  pos = IADD pos 1 8
  STORE req 104 1 pos
  pos = IADD pos 1 8
  STORE req 111 1 pos
  pos = IADD pos 1 8
  STORE req 115 1 pos
  pos = IADD pos 1 8
  STORE req 116 1 pos
  pos = IADD pos 1 8
  STORE req 13 1 pos
  pos = IADD pos 1 8
  STORE req 10 1 pos
  pos = IADD pos 1 8

  # blank line "\r\n"
  STORE req 13 1 pos
  pos = IADD pos 1 8
  STORE req 10 1 pos
  pos = IADD pos 1 8
  STORE op pos 8

  # copy body verbatim
  STORE i 0 8

  LABEL body_loop
    k = LOAD i 8
    blen = LOAD body_len 8
    done = IGE k blen 8
    BRANCH done after_body copy_byte

  LABEL copy_byte
    k = LOAD i 8
    byte = LOAD body 1 k
    pos = LOAD op 8
    STORE req byte 1 pos
    npos = IADD pos 1 8
    STORE op npos 8
    nk = IADD k 1 8
    STORE i nk 8
    JUMP body_loop

  LABEL after_body
    pos = LOAD op 8
    STORE req_len pos 8
    FREE i
    FREE op
END
