BEHAVIOR assemble-output

DESCRIPTION
  Builds the consumer output: a 19-char "YYYY-MM-DD HH:MM:SS" timestamp,
  a space, the literal "PROCESSED BY CONSUMER", a newline (0x0A), then the
  request body. Writes the total byte count to length (no trailing newline).

CONTRACT
  INPUT timestamp bytes 32
  INPUT body bytes 65536
  INPUT body_length int 8
  OUTPUT result bytes 65536
  OUTPUT length int 8
  GUARANTEES writes_output

HASH ffbc8216

IMPLEMENTATION
  # Copy 19-char timestamp into positions 0..18
  i = ALLOC 8 int
  STORE i 0 8

  LABEL ts_loop
    idx = LOAD i 8
    tdone = IGE idx 19 8
    BRANCH tdone ts_done ts_byte

  LABEL ts_byte
    idx = LOAD i 8
    byte = LOAD timestamp 1 idx
    STORE result byte 1 idx
    nidx = IADD idx 1 8
    STORE i nidx 8
    JUMP ts_loop

  LABEL ts_done
    # space at 19
    STORE result 32 1 19
    # "PROCESSED BY CONSUMER" at 20..40
    STORE result 80 1 20
    STORE result 82 1 21
    STORE result 79 1 22
    STORE result 67 1 23
    STORE result 69 1 24
    STORE result 83 1 25
    STORE result 83 1 26
    STORE result 69 1 27
    STORE result 68 1 28
    STORE result 32 1 29
    STORE result 66 1 30
    STORE result 89 1 31
    STORE result 32 1 32
    STORE result 67 1 33
    STORE result 79 1 34
    STORE result 78 1 35
    STORE result 83 1 36
    STORE result 85 1 37
    STORE result 77 1 38
    STORE result 69 1 39
    STORE result 82 1 40
    # newline at 41
    STORE result 10 1 41

  # Append body starting at 42
  STORE i 0 8
  blen = LOAD body_length 8

  LABEL body_loop
    k = LOAD i 8
    bdone = IGE k blen 8
    BRANCH bdone body_done body_byte

  LABEL body_byte
    k = LOAD i 8
    byte = LOAD body 1 k
    dst = IADD k 42 8
    STORE result byte 1 dst
    nk = IADD k 1 8
    STORE i nk 8
    JUMP body_loop

  LABEL body_done
    total = IADD blen 42 8
    STORE length total 8
    FREE i
END
