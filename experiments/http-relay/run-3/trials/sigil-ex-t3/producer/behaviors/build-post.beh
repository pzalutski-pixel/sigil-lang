BEHAVIOR build-post

DESCRIPTION
  Concatenates an HTTP request prefix (header block ending in CRLFCRLF) with a
  body, producing the full request bytes and total length.

CONTRACT
  INPUT prefix bytes 65536
  INPUT prefix_len int 8
  INPUT body bytes 65536
  INPUT body_len int 8
  OUTPUT out bytes 65536
  OUTPUT out_len int 8
  GUARANTEES writes_output

HASH 063c33b6

IMPLEMENTATION
  STORE out 0 1 0
  STORE out_len 0 8

  w = ALLOC 8 int
  STORE w 0 8
  i = ALLOC 8 int
  STORE i 0 8

  # Copy prefix
  LABEL copy_pre
    idx = LOAD i 8
    pl = LOAD prefix_len 8
    done = IGE idx pl 8
    BRANCH done end_pre copy_pre_byte

  LABEL copy_pre_byte
    idx = LOAD i 8
    byte = LOAD prefix 1 idx
    wpos = LOAD w 8
    STORE out byte 1 wpos
    nw = IADD wpos 1 8
    STORE w nw 8
    ni = IADD idx 1 8
    STORE i ni 8
    JUMP copy_pre

  LABEL end_pre
    STORE i 0 8

  # Copy body
  LABEL copy_body
    idx = LOAD i 8
    bl = LOAD body_len 8
    done = IGE idx bl 8
    BRANCH done end_body copy_body_byte

  LABEL copy_body_byte
    idx = LOAD i 8
    byte = LOAD body 1 idx
    wpos = LOAD w 8
    STORE out byte 1 wpos
    nw = IADD wpos 1 8
    STORE w nw 8
    ni = IADD idx 1 8
    STORE i ni 8
    JUMP copy_body

  LABEL end_body
    total = LOAD w 8
    STORE out_len total 8

  FREE w
  FREE i
END
