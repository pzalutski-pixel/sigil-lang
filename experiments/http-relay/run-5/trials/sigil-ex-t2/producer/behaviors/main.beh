BEHAVIOR main

DESCRIPTION
  HTTP file relay producer. Reads input.txt and sends its contents as the body
  of an HTTP POST to localhost:9822.

CONTRACT
  OUTPUT status int 8
  REQUIRES read-file-all@bf59f1e1 int-to-string@8dcdacc1 build-request@6b5ef878 socket@0fec0e0c make-sockaddr@a9866fc0 connect@697435f5 send@8c6f3cb7 close-socket@d4ba30e5 println@a273ebb3
  GUARANTEES writes_output

HASH edf40e27

COMPOSITION
  # Read input.txt
  path = "input.txt"
  rd = CALL read-file-all path

  # Content-Length text = decimal of the body length
  cl = CALL int-to-string rd.length

  # Build the HTTP POST request
  reqr = CALL build-request cl.str cl.length rd.data rd.length

  # Create TCP socket and connect to 127.0.0.1:9822
  sock_result = CALL socket 2 1
  sock_fd = sock_result.fd

  # ip 16777343 = 127.0.0.1 packed network order (octet0=127 in low byte, octet3=1)
  addr_result = CALL make-sockaddr 9822 16777343
  connect_result = CALL connect sock_fd addr_result.addr addr_result.addr_len
  DISCARD connect_result

  msg = "Producer sent input.txt to localhost:9822"
  CALL println msg

  # Send the request
  send_result = CALL send sock_fd reqr.req reqr.req_len
  DISCARD send_result

  close_result = CALL close-socket sock_fd
  DISCARD close_result

  SET status 0
END
