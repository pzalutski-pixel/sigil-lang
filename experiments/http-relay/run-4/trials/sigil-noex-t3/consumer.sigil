EXECUTABLE consumer

DESCRIPTION
  Listens on TCP port 9813 for an HTTP POST, prepends a timestamp and
  PROCESSED BY CONSUMER to the body, and writes the result to output.txt.

ENTRY
  # listening socket (AF_INET=2, SOCK_STREAM=1)
  sock = CALL socket 2 1
  # bind to 0.0.0.0:9813 (ip 0 = any)
  addr = CALL make-sockaddr 9813 0
  bound = CALL bind sock.fd addr.addr addr.addr_len
  DISCARD bound.status
  listened = CALL listen sock.fd 8
  DISCARD listened.status
  # accept one client
  client = CALL accept sock.fd
  DISCARD client.client_addr
  DISCARD client.addr_len
  # receive the request
  rx = CALL receive client.client_fd 65536
  # extract the HTTP body
  body = CALL extract-body rx.buffer rx.bytes_received
  # timestamp
  t = CALL now
  ts = CALL format-time t.timestamp
  # frame the output
  out = CALL build-output ts.formatted ts.length body.body body.body_len
  # write to output.txt
  wrote = CALL write-file-all "output.txt" out.result out.result_len
  DISCARD wrote.bytes_written
  # close sockets
  cc = CALL close-socket client.client_fd
  DISCARD cc.status
  cs = CALL close-socket sock.fd
  DISCARD cs.status
END_EXECUTABLE
