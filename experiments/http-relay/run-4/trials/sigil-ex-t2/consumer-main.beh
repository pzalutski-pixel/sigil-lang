BEHAVIOR consumer-main

DESCRIPTION
  Listens on TCP port 9822, accepts one HTTP POST, extracts the body,
  prepends "<timestamp> PROCESSED BY CONSUMER\n", and writes the result
  to output.txt.

CONTRACT
  OUTPUT status int 8
  REQUIRES socket@0fec0e0c make-sockaddr@a9866fc0 bind@697435f5 listen@95b7eb35 accept@e88849be receive@2ae7614b extract-body@1b8dfab2 now@cee78134 format-time@83ebda2d assemble-output@ffbc8216 write-file-all@b17d9aa8 close-socket@d4ba30e5
  GUARANTEES writes_output

HASH 90d45160

COMPOSITION
  # Create TCP socket (AF_INET=2, SOCK_STREAM=1)
  sock = CALL socket 2 1

  # Bind to 0.0.0.0:9822
  addr = CALL make-sockaddr 9822 0
  bound = CALL bind sock.fd addr.addr addr.addr_len
  DISCARD bound

  # Listen with backlog 1
  lis = CALL listen sock.fd 1
  DISCARD lis

  # Accept one client connection
  acc = CALL accept sock.fd
  DISCARD acc.client_addr
  DISCARD acc.addr_len

  # Receive the request (up to 65536 bytes)
  rcv = CALL receive acc.client_fd 65536
  DISCARD rcv.bytes_received

  # Extract the HTTP body
  parsed = CALL extract-body rcv.buffer rcv.bytes_received

  # Timestamp
  t = CALL now
  ft = CALL format-time t.timestamp
  DISCARD ft.length

  # Build the output framing
  out = CALL assemble-output ft.formatted parsed.body parsed.body_length

  # Write to output.txt
  opath = "output.txt"
  written = CALL write-file-all opath out.result out.length
  DISCARD written

  # Close sockets
  cc = CALL close-socket acc.client_fd
  DISCARD cc
  cs = CALL close-socket sock.fd
  DISCARD cs

  SET status 0
END
