BEHAVIOR zero

DESCRIPTION
  Zeros a region of memory.
  Writes zeros to buffer starting at offset for size bytes.
  Returns number of bytes actually written.

CONTRACT
  INPUT buffer bytes 65536
  INPUT offset int 8
  INPUT size int 8
  OUTPUT bytes_written int 8
  GUARANTEES writes_output

HASH ac217bf5

IMPLEMENTATION
  offset_val = LOAD offset 8
  size_val = LOAD size 8

  i_h = ALLOC 8 int
  STORE i_h 0 8

  LABEL loop
    i = LOAD i_h 8
    done_check = IGE i size_val 8
    BRANCH done_check done continue

  LABEL continue
    i = LOAD i_h 8
    pos = IADD offset_val i 8
    STORE buffer 0 1 pos
    new_i = IADD i 1 8
    STORE i_h new_i 8
    JUMP loop

  LABEL done
    final_count = LOAD i_h 8
    STORE bytes_written final_count 8
    FREE i_h
END
