BEHAVIOR build-request

DESCRIPTION
  Builds an HTTP POST request whose body is the given bytes. Writes a fixed
  request line and headers terminated by CRLF CRLF, then appends the body.
  Header written:
    POST / HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\n
    Content-Length: <body_len>\r\n\r\n
  Produces request + req_len.

CONTRACT
  INPUT body bytes 65536
  INPUT body_len int 8
  OUTPUT request bytes 65536
  OUTPUT req_len int 8
  GUARANTEES writes_output

HASH 44dce179

IMPLEMENTATION
  outp = ALLOC 8 int
  STORE outp 0 8
  i = ALLOC 8 int
  STORE i 0 8
  digits = ALLOC 8 int
  STORE digits 0 8
  tmp = ALLOC 8 int
  STORE tmp 0 8

  # "POST / HTTP/1.1\r\n"  (17 bytes)
  STORE request 80 1 0
  STORE request 79 1 1
  STORE request 83 1 2
  STORE request 84 1 3
  STORE request 32 1 4
  STORE request 47 1 5
  STORE request 32 1 6
  STORE request 72 1 7
  STORE request 84 1 8
  STORE request 84 1 9
  STORE request 80 1 10
  STORE request 47 1 11
  STORE request 49 1 12
  STORE request 46 1 13
  STORE request 49 1 14
  STORE request 13 1 15
  STORE request 10 1 16
  STORE outp 17 8

  # "Host: localhost\r\n" (17 bytes): H o s t : sp l o c a l h o s t \r \n
  p = LOAD outp 8
  STORE request 72 1 p
  p = IADD p 1 8
  STORE request 111 1 p
  p = IADD p 1 8
  STORE request 115 1 p
  p = IADD p 1 8
  STORE request 116 1 p
  p = IADD p 1 8
  STORE request 58 1 p
  p = IADD p 1 8
  STORE request 32 1 p
  p = IADD p 1 8
  STORE request 108 1 p
  p = IADD p 1 8
  STORE request 111 1 p
  p = IADD p 1 8
  STORE request 99 1 p
  p = IADD p 1 8
  STORE request 97 1 p
  p = IADD p 1 8
  STORE request 108 1 p
  p = IADD p 1 8
  STORE request 104 1 p
  p = IADD p 1 8
  STORE request 111 1 p
  p = IADD p 1 8
  STORE request 115 1 p
  p = IADD p 1 8
  STORE request 116 1 p
  p = IADD p 1 8
  STORE request 13 1 p
  p = IADD p 1 8
  STORE request 10 1 p
  p = IADD p 1 8
  STORE outp p 8

  # "Content-Length: " (16 bytes): C o n t e n t - L e n g t h : sp
  p = LOAD outp 8
  STORE request 67 1 p
  p = IADD p 1 8
  STORE request 111 1 p
  p = IADD p 1 8
  STORE request 110 1 p
  p = IADD p 1 8
  STORE request 116 1 p
  p = IADD p 1 8
  STORE request 101 1 p
  p = IADD p 1 8
  STORE request 110 1 p
  p = IADD p 1 8
  STORE request 116 1 p
  p = IADD p 1 8
  STORE request 45 1 p
  p = IADD p 1 8
  STORE request 76 1 p
  p = IADD p 1 8
  STORE request 101 1 p
  p = IADD p 1 8
  STORE request 110 1 p
  p = IADD p 1 8
  STORE request 103 1 p
  p = IADD p 1 8
  STORE request 116 1 p
  p = IADD p 1 8
  STORE request 104 1 p
  p = IADD p 1 8
  STORE request 58 1 p
  p = IADD p 1 8
  STORE request 32 1 p
  p = IADD p 1 8
  STORE outp p 8

  # body_len as decimal (assumes 1..99999; handles 0 as "0")
  bl = LOAD body_len 8
  is_zero = IEQ bl 0 8
  BRANCH is_zero write_zero count_digits

  LABEL write_zero
    p = LOAD outp 8
    STORE request 48 1 p
    np = IADD p 1 8
    STORE outp np 8
    JUMP after_number

  LABEL count_digits
    # determine number of digits by repeated division
    bl_init = LOAD body_len 8
    STORE tmp bl_init 8
    STORE digits 0 8

  LABEL count_loop
    t = LOAD tmp 8
    nonzero = IGT t 0 8
    BRANCH nonzero count_step after_count

  LABEL count_step
    t = LOAD tmp 8
    t2 = IDIV t 10 8
    tmp2 = IMUL t2 10 8
    # update tmp = t / 10
    STORE tmp t2 8
    d = LOAD digits 8
    nd = IADD d 1 8
    STORE digits nd 8
    DISCARD tmp2
    JUMP count_loop

  LABEL after_count
    # write digits least-significant first, placed from the right end
    bl_again = LOAD body_len 8
    STORE tmp bl_again 8
    STORE i 0 8

  LABEL write_digits
    k = LOAD i 8
    done = IGE k nd 8
    BRANCH done finish_number write_one_digit

  LABEL write_one_digit
    t = LOAD tmp 8
    rem = IMOD t 10 8
    ch = IADD rem 48 8
    nd2 = LOAD digits 8
    k = LOAD i 8
    fromend = IADD k 1 8
    posoff = ISUB nd2 fromend 8
    base = LOAD outp 8
    pos = IADD base posoff 8
    STORE request ch 1 pos
    t2 = IDIV t 10 8
    STORE tmp t2 8
    nk = IADD k 1 8
    STORE i nk 8
    JUMP write_digits

  LABEL finish_number
    nd2 = LOAD digits 8
    base = LOAD outp 8
    newp = IADD base nd2 8
    STORE outp newp 8

  LABEL after_number
    # "\r\n\r\n" (4 bytes)
    p = LOAD outp 8
    STORE request 13 1 p
    p = IADD p 1 8
    STORE request 10 1 p
    p = IADD p 1 8
    STORE request 13 1 p
    p = IADD p 1 8
    STORE request 10 1 p
    p = IADD p 1 8
    STORE outp p 8

    # append body
    STORE i 0 8

  LABEL copy_body
    k = LOAD i 8
    bl2 = LOAD body_len 8
    done_b = IGE k bl2 8
    BRANCH done_b body_done copy_body_byte

  LABEL copy_body_byte
    k = LOAD i 8
    byte = LOAD body 1 k
    p = LOAD outp 8
    STORE request byte 1 p
    np = IADD p 1 8
    STORE outp np 8
    nk = IADD k 1 8
    STORE i nk 8
    JUMP copy_body

  LABEL body_done
    final = LOAD outp 8
    STORE req_len final 8
    FREE outp
    FREE i
    FREE digits
    FREE tmp
END
