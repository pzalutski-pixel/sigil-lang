BEHAVIOR build-consumer-output

DESCRIPTION
  Assembles the consumer's framed result from a raw HTTP request and a
  formatted timestamp string. Locates the HTTP body (the bytes after the
  first CRLFCRLF; falls back to the whole request if absent), then writes
  <timestamp[0..19]> + " PROCESSED BY CONSUMER\n" + <body> into out, and the
  total byte count into out_len. Pure byte assembly via primitives.

CONTRACT
  INPUT request bytes 65536
  INPUT req_len int 8
  INPUT timestamp_str bytes 32
  OUTPUT out bytes 65536
  OUTPUT out_len int 8
  GUARANTEES writes_output

HASH 0095a4d9

IMPLEMENTATION
  # --- locate body start: first index where request[i..i+4] == 0D 0A 0D 0A ---
  body_start = ALLOC 8 int
  STORE body_start 0 8
  found = ALLOC 8 int
  STORE found 0 8
  i = ALLOC 8 int
  STORE i 0 8

  # req_len is an int INPUT handle; read its value
  rl = LOAD req_len 8

  # scan limit = req_len - 4 (need 4 bytes to match)
  limit = ISUB rl 4 8

  LABEL scan_start
    iv = LOAD i 8
    # if found already, stop scanning
    fv = LOAD found 8
    BRANCH fv scan_end scan_check
  LABEL scan_check
    past = IGT iv limit 8
    BRANCH past scan_end scan_test
  LABEL scan_test
    b0 = LOAD request 1 iv
    o1 = IADD iv 1 8
    b1 = LOAD request 1 o1
    o2 = IADD iv 2 8
    b2 = LOAD request 1 o2
    o3 = IADD iv 3 8
    b3 = LOAD request 1 o3
    m0 = IEQ b0 13 1
    m1 = IEQ b1 10 1
    m2 = IEQ b2 13 1
    m3 = IEQ b3 10 1
    a01 = AND m0 m1 1
    a23 = AND m2 m3 1
    allm = AND a01 a23 1
    BRANCH allm scan_hit scan_next
  LABEL scan_hit
    bs = IADD iv 4 8
    STORE body_start bs 8
    STORE found 1 8
    JUMP scan_start
  LABEL scan_next
    inext = IADD iv 1 8
    STORE i inext 8
    JUMP scan_start
  LABEL scan_end

  # if not found, body_start stays 0 -> body is the whole request
  fv2 = LOAD found 8
  BRANCH fv2 have_start no_crlf
  LABEL no_crlf
    STORE body_start 0 8
    JUMP have_start
  LABEL have_start

  bstart = LOAD body_start 8
  body_len = ISUB rl bstart 8

  # --- write timestamp[0..19] into out[0..19] ---
  ti = ALLOC 8 int
  STORE ti 0 8
  LABEL ts_loop
    tv = LOAD ti 8
    tdone = IGE tv 19 8
    BRANCH tdone ts_done ts_body
  LABEL ts_body
    tc = LOAD timestamp_str 1 tv
    STORE out tc 1 tv
    tn = IADD tv 1 8
    STORE ti tn 8
    JUMP ts_loop
  LABEL ts_done

  # --- write constant " PROCESSED BY CONSUMER\n" (23 bytes) into out[19..42] ---
  STORE out 32 1 19
  STORE out 80 1 20
  STORE out 82 1 21
  STORE out 79 1 22
  STORE out 67 1 23
  STORE out 69 1 24
  STORE out 83 1 25
  STORE out 83 1 26
  STORE out 69 1 27
  STORE out 68 1 28
  STORE out 32 1 29
  STORE out 66 1 30
  STORE out 89 1 31
  STORE out 32 1 32
  STORE out 67 1 33
  STORE out 79 1 34
  STORE out 78 1 35
  STORE out 83 1 36
  STORE out 85 1 37
  STORE out 77 1 38
  STORE out 69 1 39
  STORE out 82 1 40
  STORE out 10 1 41

  # --- copy body bytes into out starting at offset 42 ---
  ci = ALLOC 8 int
  STORE ci 0 8
  LABEL body_loop
    cv = LOAD ci 8
    cdone = IGE cv body_len 8
    BRANCH cdone body_done body_copy
  LABEL body_copy
    srcoff = IADD bstart cv 8
    bc = LOAD request 1 srcoff
    dstoff = IADD cv 42 8
    STORE out bc 1 dstoff
    cn = IADD cv 1 8
    STORE ci cn 8
    JUMP body_loop
  LABEL body_done

  total = IADD body_len 42 8
  STORE out_len total 8

  FREE body_start
  FREE found
  FREE i
  FREE ti
  FREE ci
END
