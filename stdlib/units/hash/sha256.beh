  t = IADD lenv 8 8
  q = IDIV t 64 8
  blocks = IADD q 1 8
  plen = IMUL blocks 64 8

  z = 0
  LABEL zloop
    zdone = IGE z plen 8
    BRANCH zdone zfin zbody
  LABEL zbody
    zoff = IADD z 512 8
    STORE buf 0 1 zoff
    z = IADD z 1 8
    JUMP zloop
  LABEL zfin

  j = 0
  LABEL cploop
    cpdone = IGE j lenv 8
    BRANCH cpdone cpfin cpbody
  LABEL cpbody
    db = LOAD data 1 j
    db = AND db 255 8
    moff = IADD j 512 8
    STORE buf db 1 moff
    j = IADD j 1 8
    JUMP cploop
  LABEL cpfin

  eoff = IADD lenv 512 8
  STORE buf 128 1 eoff

  bitlen = IMUL lenv 8 8
  lbase = IADD plen 512 8
  lbase = ISUB lbase 8 8
  lb = SHR bitlen 56 8
  lb = AND lb 255 8
  STORE buf lb 1 lbase
  o1 = IADD lbase 1 8
  lb = SHR bitlen 48 8
  lb = AND lb 255 8
  STORE buf lb 1 o1
  o2 = IADD lbase 2 8
  lb = SHR bitlen 40 8
  lb = AND lb 255 8
  STORE buf lb 1 o2
  o3 = IADD lbase 3 8
