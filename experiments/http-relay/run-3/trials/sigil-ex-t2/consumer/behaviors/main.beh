BEHAVIOR main

DESCRIPTION
  HTTP file-relay consumer. Listens on port 9815, accepts one POST,
  prepends a timestamp + "PROCESSED BY CONSUMER" line to the body, and
  writes the result to output.txt.

CONTRACT
  OUTPUT status int 8
  REQUIRES socket@0fec0e0c bind-9815@a3081b58 listen@95b7eb35 accept@e88849be receive@2ae7614b now@cee78134 format-time@83ebda2d build-output@5f56fa39 open@7d62cd96 write@874767ff close@d4ba30e5 close-socket@d4ba30e5 println@a273ebb3
  GUARANTEES writes_output

HASH e512e502

COMPOSITION
  # Create TCP socket (AF_INET=2, SOCK_STREAM=1)
  sock_result = CALL socket 2 1
  sock_fd = sock_result.fd

  # Bind to 9815
  bind_result = CALL bind-9815 sock_fd
  DISCARD bind_result

  # Listen with backlog 10
  listen_result = CALL listen sock_fd 10
  DISCARD listen_result

  ready = "Consumer listening on port 9815"
  CALL println ready

  # Accept one connection
  accept_result = CALL accept sock_fd
  client_fd = accept_result.client_fd
  DISCARD accept_result.client_addr
  DISCARD accept_result.addr_len

  # Receive the request (up to 65536 bytes)
  recv_result = CALL receive client_fd 65536

  # Timestamp
  now_result = CALL now
  ts_result = CALL format-time now_result.timestamp

  # Build the output buffer
  built = CALL build-output recv_result.buffer recv_result.bytes_received ts_result.formatted ts_result.length

  # Write to output.txt (flags = write|create = 3)
  out_path = "output.txt"
  open_result = CALL open out_path 3
  write_result = CALL write open_result.fd built.result built.result_length
  DISCARD write_result

  close_result = CALL close open_result.fd
  DISCARD close_result

  cs = CALL close-socket client_fd
  DISCARD cs

  css = CALL close-socket sock_fd
  DISCARD css

  SET status 0
END
