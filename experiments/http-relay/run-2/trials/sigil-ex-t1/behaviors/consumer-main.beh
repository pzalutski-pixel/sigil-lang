BEHAVIOR consumer-main

DESCRIPTION
  Consumer: listens on port 9817 for one HTTP POST.
  Prepends "<timestamp> PROCESSED BY CONSUMER\n" to the POST body,
  writes the result to output.txt.

CONTRACT
  OUTPUT status int 8
  REQUIRES socket@0fec0e0c bind@697435f5 make-addr-9817@00f67ec4 listen@95b7eb35 accept@e88849be receive@2ae7614b now@cee78134 format-time@83ebda2d build-output@ea066e13 open@31f81967 write@874767ff close@d4ba30e5 close-socket@d4ba30e5
  GUARANTEES writes_output

HASH 7a131c80

COMPOSITION
  # Create TCP socket (AF_INET=2, SOCK_STREAM=1)
  sock_result = CALL socket 2 1
  sock_fd = sock_result.fd

  # Bind to port 9817
  addr_result = CALL make-addr-9817
  bind_result = CALL bind sock_fd addr_result.addr 16

  # Listen with backlog 1
  listen_result = CALL listen sock_fd 1

  # Accept one connection
  accept_result = CALL accept sock_fd
  client_fd = accept_result.client_fd

  # Receive the request (up to 65536 bytes)
  recv_result = CALL receive client_fd 65536

  # Get current timestamp
  time_result = CALL now
  fmt_result = CALL format-time time_result.timestamp

  # Build output buffer
  out_result = CALL build-output fmt_result.formatted recv_result.buffer recv_result.bytes_received

  # Write output.txt (flags = write+create = 3)
  out_path = "output.txt"
  open_result = CALL open out_path 3
  write_result = CALL write open_result.fd out_result.result out_result.result_length
  close_result = CALL close open_result.fd

  # Close sockets
  close_client = CALL close-socket client_fd
  close_server = CALL close-socket sock_fd

  SET status 0
END
