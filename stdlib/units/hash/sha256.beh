    s0a = AND s0a M 8
    s0b1 = SHR w15 18 8
    s0b2 = SHL w15 14 8
    s0b = OR s0b1 s0b2 8
    s0b = AND s0b M 8
    s0c = SHR w15 3 8
    s0 = XOR s0a s0b 8
    s0 = XOR s0 s0c 8
    s1a1 = SHR w2 17 8
    s1a2 = SHL w2 15 8
    s1a = OR s1a1 s1a2 8
    s1a = AND s1a M 8
    s1b1 = SHR w2 19 8
    s1b2 = SHL w2 13 8
    s1b = OR s1b1 s1b2 8
    s1b = AND s1b M 8
    s1c = SHR w2 10 8
    s1 = XOR s1a s1b 8
    s1 = XOR s1 s1c 8
    wt = IADD w16 s0 8
    wt = IADD wt w7 8
    wt = IADD wt s1 8
    wt = AND wt M 8
    t4e = IMUL t 4 8
    woffe = IADD t4e 256 8
    STORE buf wt 4 woffe
    t = IADD t 1 8
    JUMP wext
  LABEL wefin

    a = IADD h0 0 8
    b = IADD h1 0 8
    c = IADD h2 0 8
    d = IADD h3 0 8
    e = IADD h4 0 8
    f = IADD h5 0 8
