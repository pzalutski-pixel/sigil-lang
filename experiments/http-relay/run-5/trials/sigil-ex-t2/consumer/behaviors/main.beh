BEHAVIOR main

DESCRIPTION
  HTTP file relay consumer. Listens on TCP port 9822, accepts one HTTP POST,
  extracts the request body, prepends "<timestamp> PROCESSED BY CONSUMER\n",
  and writes the result to output.txt.

CONTRACT
  OUTPUT status int 8
  REQUIRES socket@0fec0e0c make-sockaddr@a9866fc0 bind@697435f5 listen@95b7eb35 accept@e88849be receive@2ae7614b extract-body@1e5f295a now@cee78134 format-time@83ebda2d build-output@4ead1cca write-file-all@b17d9aa8 close-socket@d4ba30e5 println@a273ebb3
  GUARANTEES writes_output

HASH d54e8a58

COMPOSITION
  # Create TCP socket (AF_INET=2, SOCK_STREAM=1)
  sock_result = CALL socket 2 1
  sock_fd = sock_result.fd

  # Bind to port 9822 on all interfaces (ip 0.0.0.0)
  addr_result = CALL make-sockaddr 9822 0
  bind_result = CALL bind sock_fd addr_result.addr addr_result.addr_len
  DISCARD bind_result

  # Listen with backlog 10
  listen_result = CALL listen sock_fd 10
  DISCARD listen_result

  msg = "Consumer listening on port 9822"
  CALL println msg

  # Accept one connection (peer address fields unused)
  accept_result = CALL accept sock_fd
  client_fd = accept_result.client_fd
  DISCARD accept_result.client_addr
  DISCARD accept_result.addr_len

  # Receive the HTTP request (up to 65536 bytes)
  recv_result = CALL receive client_fd 65536
  DISCARD recv_result.bytes_received

  # Extract the request body
  body_result = CALL extract-body recv_result.buffer recv_result.bytes_received

  # Timestamp
  time_result = CALL now
  fmt_result = CALL format-time time_result.timestamp
  DISCARD fmt_result.length

  # Build output buffer: <ts> PROCESSED BY CONSUMER\n<body>
  out_result = CALL build-output fmt_result.formatted body_result.body body_result.body_len

  # Write to output.txt
  path = "output.txt"
  write_result = CALL write-file-all path out_result.out out_result.out_len
  DISCARD write_result

  # Close client socket
  close_result = CALL close-socket client_fd
  DISCARD close_result

  SET status 0
END
