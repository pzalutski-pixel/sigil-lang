BEHAVIOR find

DESCRIPTION
  Finds first occurrence of needle in haystack.
  Returns byte offset of first match, or -1 if not found.
  Search is byte-by-byte, not unicode-aware.

CONTRACT
  INPUT haystack bytes 65536
  INPUT needle bytes 256
  OUTPUT index int 8
  GUARANTEES writes_output

HASH 7f2c5e1c

IMPLEMENTATION
  # Find first occurrence of needle in haystack

  # Get needle length
  needle_len = ALLOC 8 int
  STORE needle_len 0 8

  LABEL get_needle_len
    nl_val = LOAD needle_len 8
    byte = LOAD needle 1 nl_val
    is_null = IEQ byte 0 1
    BRANCH is_null needle_len_done inc_needle_len

  LABEL inc_needle_len
    nl_val = LOAD needle_len 8
    new_nl = IADD nl_val 1 8
    STORE needle_len new_nl 8
    at_max = IGE new_nl 256 8
    BRANCH at_max needle_len_done get_needle_len

  LABEL needle_len_done
    # Empty needle - return 0
    nl_val = LOAD needle_len 8
    is_empty = IEQ nl_val 0 8
    BRANCH is_empty found_at_zero search_start

  LABEL found_at_zero
    STORE index 0 8
    JUMP done

  LABEL search_start
    pos = ALLOC 8 int
    STORE pos 0 8

  LABEL search_loop
    pos_val = LOAD pos 8
    at_end = IGE pos_val 65536 8
    BRANCH at_end not_found try_match

  LABEL try_match
    match_pos = ALLOC 8 int
    STORE match_pos 0 8

  LABEL match_loop
    mp_val = LOAD match_pos 8
    nl_val = LOAD needle_len 8
    matched_all = IGE mp_val nl_val 8
    BRANCH matched_all found continue_match

  LABEL continue_match
    pos_val = LOAD pos 8
    mp_val = LOAD match_pos 8
    hay_idx = IADD pos_val mp_val 8
    hay_char = LOAD haystack 1 hay_idx
    needle_char = LOAD needle 1 mp_val
    chars_equal = IEQ hay_char needle_char 1
    BRANCH chars_equal match_next no_match_here

  LABEL match_next
    mp_val = LOAD match_pos 8
    new_mp = IADD mp_val 1 8
    STORE match_pos new_mp 8
    JUMP match_loop

  LABEL no_match_here
    FREE match_pos
    pos_val = LOAD pos 8
    new_pos = IADD pos_val 1 8
    STORE pos new_pos 8
    JUMP search_loop

  LABEL found
    FREE match_pos
    pos_val = LOAD pos 8
    STORE index pos_val 8
    JUMP done

  LABEL not_found
    STORE index -1 8

  LABEL done
    FREE needle_len
    FREE pos
END
