  STORE buf lb 1 o5
  o6 = IADD lbase 6 8
  lb = SHR bitlen 8 8
  lb = AND lb 255 8
  STORE buf lb 1 o6
  o7 = IADD lbase 7 8
  lb = AND bitlen 255 8
  STORE buf lb 1 o7

  h0 = 1779033703
