BEHAVIOR build-request

DESCRIPTION
  Builds a minimal HTTP POST request whose body is the given data.
  Prefix: "POST / HTTP/1.1\r\n\r\n" followed by the body bytes.

CONTRACT
  INPUT body bytes 65536
  INPUT body_len int 8
  OUTPUT request bytes 65536
  OUTPUT request_len int 8
  GUARANTEES writes_output

HASH 757a97ba

IMPLEMENTATION
  out_pos = ALLOC 8 int
  STORE out_pos 0 8
  i = ALLOC 8 int
  STORE i 0 8

  # "POST / HTTP/1.1\r\n\r\n" (19 bytes)
  STORE request 80 1 0
  STORE request 79 1 1
  STORE request 83 1 2
  STORE request 84 1 3
  STORE request 32 1 4
  STORE request 47 1 5
  STORE request 32 1 6
  STORE request 72 1 7
  STORE request 84 1 8
  STORE request 84 1 9
  STORE request 80 1 10
  STORE request 47 1 11
  STORE request 49 1 12
  STORE request 46 1 13
  STORE request 49 1 14
  STORE request 13 1 15
  STORE request 10 1 16
  STORE request 13 1 17
  STORE request 10 1 18
  STORE out_pos 19 8

  # Append body bytes
  blen = LOAD body_len 8
  STORE i 0 8
  LABEL copy_body
    idx = LOAD i 8
    done = IGE idx blen 8
    BRANCH done end_body copy_byte
  LABEL copy_byte
    idx = LOAD i 8
    b = LOAD body 1 idx
    pos = LOAD out_pos 8
    STORE request b 1 pos
    npos = IADD pos 1 8
    STORE out_pos npos 8
    nidx = IADD idx 1 8
    STORE i nidx 8
    JUMP copy_body
  LABEL end_body
    pos = LOAD out_pos 8
    STORE request_len pos 8

  FREE out_pos
  FREE i
END
