BEHAVIOR make-sockaddr

DESCRIPTION
  Builds a 16-byte sockaddr_in (IPv4) into addr.
  Byte 0-1: family = AF_INET (2, little-endian).
  Byte 2-3: port in network (big-endian) order.
  Byte 4-7: IPv4 address in network (big-endian) order.
  ip is a host-order 32-bit value, e.g. 0x7F000001 for 127.0.0.1.

CONTRACT
  INPUT port int 8
  INPUT ip int 8
  OUTPUT addr bytes 128
  OUTPUT addr_len int 8
  GUARANTEES writes_output

HASH a9866fc0

IMPLEMENTATION
  pv = LOAD port 8
  iv = LOAD ip 8
  STORE addr 2 1 0
  STORE addr 0 1 1
  ph = SHR pv 8 8
  pl = AND pv 255 8
  STORE addr ph 1 2
  STORE addr pl 1 3
  i0 = SHR iv 24 8
  i1 = SHR iv 16 8
  i2 = SHR iv 8 8
  b0 = AND i0 255 8
  b1 = AND i1 255 8
  b2 = AND i2 255 8
  b3 = AND iv 255 8
  STORE addr b0 1 4
  STORE addr b1 1 5
  STORE addr b2 1 6
  STORE addr b3 1 7
  STORE addr_len 16 8
END
